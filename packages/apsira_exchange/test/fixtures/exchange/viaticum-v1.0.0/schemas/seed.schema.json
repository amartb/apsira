{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:viaticum:exchange:1.0:seed",
  "title": "VIATICUM seed (viaticum.seed) 1.0",
  "description": "05 §2 and §3: VELLUM's site list, read once by VIATICUM to create its archive profiles. Unknown keys are ignored; an optional field that is null is absent (05 §2.1). Archive vellum_ids are unique within the file: a rule JSON Schema cannot state, checked by tool/exchange/validate_examples.py and the parser.",
  "type": "object",
  "required": ["format", "format_version", "artifact_id", "produced_at", "producer", "archives"],
  "properties": {
    "format": { "const": "viaticum.seed" },
    "format_version": { "$ref": "#/$defs/formatVersion" },
    "artifact_id": { "$ref": "#/$defs/uuid" },
    "produced_at": { "$ref": "#/$defs/instant" },
    "producer": { "$ref": "#/$defs/producer" },
    "archives": {
      "type": "array",
      "items": { "$ref": "#/$defs/seedArchive" }
    }
  },
  "$defs": {
    "formatVersion": {
      "description": "MAJOR.MINOR; this schema reads major 1, any minor (05 §10).",
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "uuid": {
      "description": "Lowercase canonical UUID, any version (05 §2.2).",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuidOrNull": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
    "instant": {
      "description": "ISO 8601 in UTC with Z, milliseconds optional (05 §2.2). The calendar check (no 30 February) is the reader's.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "keyOrNull": { "anyOf": [{ "$ref": "#/$defs/key" }, { "type": "null" }] },
    "text": { "type": ["string", "null"] },
    "nonBlank": { "type": "string", "pattern": "\\S" },
    "zoneOrNull": {
      "description": "An IANA zone name; VIATICUM defaults to Europe/Madrid (05 §4.2).",
      "anyOf": [
        { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$" },
        { "type": "null" }
      ]
    },
    "producer": {
      "type": "object",
      "required": ["app", "app_version"],
      "properties": {
        "app": { "enum": ["vellum", "viaticum"] },
        "app_version": { "type": "string" }
      }
    },
    "seedArchive": {
      "description": "An archive identity (05 §4.2) and VELLUM's practical fields (05 §3.1).",
      "type": "object",
      "required": ["vellum_id", "slug", "name"],
      "properties": {
        "vellum_id": { "$ref": "#/$defs/uuid" },
        "viaticum_id": { "$ref": "#/$defs/uuidOrNull" },
        "slug": { "$ref": "#/$defs/nonBlank" },
        "name": { "$ref": "#/$defs/nonBlank" },
        "short_name": { "$ref": "#/$defs/text" },
        "city": { "$ref": "#/$defs/text" },
        "province": { "$ref": "#/$defs/text" },
        "country": { "$ref": "#/$defs/text" },
        "address": { "$ref": "#/$defs/text" },
        "pares_code": { "$ref": "#/$defs/text" },
        "tz": { "$ref": "#/$defs/zoneOrNull" },
        "practical": {
          "type": ["object", "null"],
          "properties": {
            "opening_hours_text": {
              "description": "VELLUM's free-text hours by day key, as stored.",
              "type": ["object", "null"],
              "additionalProperties": { "type": ["string", "null"] }
            },
            "appointment_required": { "type": ["boolean", "null"] },
            "photo_policy": { "$ref": "#/$defs/text" },
            "access_notes": { "$ref": "#/$defs/text" },
            "website": { "$ref": "#/$defs/text" },
            "site_type": { "$ref": "#/$defs/keyOrNull" },
            "notes": { "$ref": "#/$defs/text" }
          }
        }
      }
    }
  }
}
