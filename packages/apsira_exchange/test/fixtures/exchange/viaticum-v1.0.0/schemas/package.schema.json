{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:viaticum:exchange:1.0:package",
  "title": "VIATICUM trip package (viaticum.package) 1.0",
  "description": "05 §2 and §4: one trip's selection from VELLUM. Unknown keys are ignored; an optional field that is null is absent (05 §2.1). Rules 3 and 4 of 05 §4.5 (item vellum_ids unique; every archive_vellum_id names an archive of the file) and unique archive vellum_ids cannot be stated in JSON Schema: tool/exchange/validate_examples.py and the parser check them. Rule 6 (size) is the reader's guard.",
  "type": "object",
  "required": ["format", "format_version", "artifact_id", "produced_at", "producer", "trip", "archives", "items"],
  "properties": {
    "format": { "const": "viaticum.package" },
    "format_version": { "$ref": "#/$defs/formatVersion" },
    "artifact_id": { "$ref": "#/$defs/uuid" },
    "produced_at": { "$ref": "#/$defs/instant" },
    "producer": { "$ref": "#/$defs/producer" },
    "trip": { "$ref": "#/$defs/trip" },
    "archives": {
      "description": "Every archive any item refers to (05 §4.2).",
      "type": "array",
      "items": { "$ref": "#/$defs/archive" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "formatVersion": {
      "description": "MAJOR.MINOR; this schema reads major 1, any minor (05 §10).",
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "uuid": {
      "description": "Lowercase canonical UUID, any version (05 §2.2).",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "uuidOrNull": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
    "instant": {
      "description": "ISO 8601 in UTC with Z, milliseconds optional (05 §2.2). The calendar check (no 30 February) is the reader's.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$"
    },
    "date": {
      "description": "A floating calendar date, YYYY-MM-DD (05 §2.2). The calendar check is the reader's.",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "text": { "type": ["string", "null"] },
    "nonBlank": { "type": "string", "pattern": "\\S" },
    "zoneOrNull": {
      "description": "An IANA zone name; VIATICUM defaults to Europe/Madrid (05 §4.2).",
      "anyOf": [
        { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+)*$" },
        { "type": "null" }
      ]
    },
    "producer": {
      "type": "object",
      "required": ["app", "app_version"],
      "properties": {
        "app": { "enum": ["vellum", "viaticum"] },
        "app_version": { "type": "string" }
      }
    },
    "trip": {
      "description": "05 §4.1. vellum_trip_id is stable across versions; version starts at 1 and strictly increases.",
      "type": "object",
      "required": ["vellum_trip_id", "version", "title"],
      "properties": {
        "vellum_trip_id": { "$ref": "#/$defs/uuid" },
        "version": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "date_hint": {
          "type": ["object", "null"],
          "required": ["start", "end"],
          "properties": {
            "start": { "$ref": "#/$defs/date" },
            "end": { "$ref": "#/$defs/date" }
          }
        },
        "research_statement": { "$ref": "#/$defs/text" }
      }
    },
    "archive": {
      "description": "An archive identity (05 §4.2).",
      "type": "object",
      "required": ["vellum_id", "slug", "name"],
      "properties": {
        "vellum_id": { "$ref": "#/$defs/uuid" },
        "viaticum_id": { "$ref": "#/$defs/uuidOrNull" },
        "slug": { "$ref": "#/$defs/nonBlank" },
        "name": { "$ref": "#/$defs/nonBlank" },
        "short_name": { "$ref": "#/$defs/text" },
        "city": { "$ref": "#/$defs/text" },
        "province": { "$ref": "#/$defs/text" },
        "country": { "$ref": "#/$defs/text" },
        "address": { "$ref": "#/$defs/text" },
        "pares_code": { "$ref": "#/$defs/text" },
        "tz": { "$ref": "#/$defs/zoneOrNull" }
      }
    },
    "item": {
      "description": "One requested unit; in VELLUM, a physical lead (05 §4.3).",
      "type": "object",
      "required": ["vellum_id", "archive_vellum_id", "signatura", "title", "priority"],
      "properties": {
        "vellum_id": { "$ref": "#/$defs/uuid" },
        "archive_vellum_id": { "$ref": "#/$defs/uuid" },
        "signatura": { "type": "string" },
        "fondo": { "$ref": "#/$defs/text" },
        "seccion": { "$ref": "#/$defs/text" },
        "serie": { "$ref": "#/$defs/text" },
        "title": { "type": "string", "description": "Required, may be empty." },
        "date_text": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "research_question": { "$ref": "#/$defs/text" },
        "priority": { "description": "1-5, 1 = highest (05 §4.4).", "type": "integer", "minimum": 1, "maximum": 5 },
        "brief": {
          "type": ["object", "null"],
          "required": ["vellum_id", "title"],
          "properties": {
            "vellum_id": { "$ref": "#/$defs/uuid" },
            "title": { "type": "string" }
          }
        },
        "source_url": { "$ref": "#/$defs/text" },
        "request_hint": { "enum": ["advance", "on_site", null] }
      }
    }
  }
}
